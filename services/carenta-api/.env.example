# Backend-only Supabase configuration. Copy to services/carenta-api/.env
# (ignored by Git) and fill in values from the Supabase dashboard.
# NEVER put these values in apps/mobile or any EXPO_PUBLIC_* variable:
# the service-role key bypasses row-level security.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

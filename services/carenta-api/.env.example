# Backend-only configuration. Copy to services/carenta-api/.env (gitignored)
# and fill with values from your Supabase dashboard.
# NEVER put SUPABASE_SERVICE_ROLE_KEY in apps/mobile or any EXPO_PUBLIC_* var.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Optional JWT verification overrides (when verifying HS256 tokens directly)
# SUPABASE_JWT_SECRET=replace-with-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated

# Explicit opt-in for unauthenticated LAN testing ONLY when Supabase env vars are unset
CARENTA_LOCAL_DEV_AUTH=false

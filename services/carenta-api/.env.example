# Backend-only configuration for services/carenta-api (Supabase RLS, JWT auth & Local Dev Mode).
# Copy to services/carenta-api/.env (gitignored) and run uvicorn with:
#   uv run --project services/carenta-api --env-file services/carenta-api/.env uvicorn app.main:app --app-dir services/carenta-api --port 8000
# NEVER put SUPABASE_SERVICE_ROLE_KEY or SUPABASE_JWT_SECRET in apps/mobile or any EXPO_PUBLIC_* variable:
# the service-role key bypasses row-level security.

# Supabase settings (#42 / app/settings.py)
# Uncomment and replace with real project values to enable Supabase JWT verification & RLS:
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=replace-with-anon-key
# SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# JWT verification & explicit LAN Local Dev Mode (#46 / app/auth.py)
# Leave SUPABASE_URL and SUPABASE_JWT_SECRET unset for explicit Local Dev Mode.
# SUPABASE_JWT_SECRET=replace-with-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated
CARENTA_LOCAL_DEV_AUTH=false

# In-process background scheduler & internal cron trigger (#59 / app/settings.py)
# CARENTA_SCHEDULER_ENABLED=false
# CARENTA_SCHEDULER_POLL_SECONDS=60
# CARENTA_EVENING_REMINDER_TIME=20:00
# CARENTA_HABIT_ANALYSIS_TIME=07:30
# CARENTA_SCHEDULER_SECRET=replace-with-long-random-scheduler-secret

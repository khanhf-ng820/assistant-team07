# Backend auth environment variables read by services/carenta-api/app/auth.py.
# Copy to services/carenta-api/.env (gitignored) and run uvicorn with:
#   uv run --project services/carenta-api --env-file services/carenta-api/.env ...
# Leave SUPABASE_URL and SUPABASE_JWT_SECRET unset for explicit Local Dev Mode.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_JWT_SECRET=replace-with-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated

# Explicit opt-in for unauthenticated LAN testing ONLY when Supabase env vars are unset
CARENTA_LOCAL_DEV_AUTH=false

# Public configuration bundled into the app; NEVER put secrets here.
# NEVER add SUPABASE_SERVICE_ROLE_KEY or database passwords to apps/mobile.

# Replace with your computer's LAN IPv4 address for FastAPI testing in Expo Go.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# Optional Supabase public auth config. Leave unset for Local Dev Mode over LAN.
# EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
